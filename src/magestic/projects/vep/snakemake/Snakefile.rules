"""
VEP Pipeline Snakemake Rules
============================

Include-able rules for running Variant Effect Prediction models.

REQUIRED CONFIG VARIABLES (define before include):
    VEP_DIR: Path to common/scripts/variant_effect_prediction/
    FASTA_50KB_DIR: Directory containing 50kb FASTA files (for Evo2, Yorzoi)
    FASTA_16KB_DIR: Directory containing 16kb FASTA files (for Shorkie)
    PROTEIN_VARIANTS_FILE: TSV with protein variants (for ESM1-v)
    METADATA_FILE: Test metadata TSV
    OUTPUT_DIR: Base output directory for all models

OPTIONAL CONFIG VARIABLES:
    EVO2_MODEL: "evo2_7b" or "evo2_40b" (default: "evo2_7b")
    EVO2_CONTAINER: Path to Evo2 Singularity container
    MODELS_TO_RUN: List of models to run (default: all)
    PYTHON: Python interpreter path

Usage in project Snakefile:

    from pathlib import Path

    # Required configuration
    VEP_DIR = Path("/path/to/common/scripts/variant_effect_prediction")
    FASTA_50KB_DIR = Path("path/to/fasta_50kb")
    FASTA_16KB_DIR = Path("path/to/fasta_16kb")
    PROTEIN_VARIANTS_FILE = Path("path/to/protein_variants.tsv")
    METADATA_FILE = Path("path/to/metadata.tsv")
    OUTPUT_DIR = Path("path/to/output")

    # Optional
    EVO2_MODEL = "evo2_7b"
    MODELS_TO_RUN = ["evo2", "yorzoi", "shorkie", "esm1v"]

    # Include VEP rules
    include: str(VEP_DIR / "snakemake/Snakefile.rules")

    # Define your workflow
    rule all:
        input:
            OUTPUT_DIR / "vep_merged_predictions.tsv"

Author: Kevin R. Roy
Date: 2026-02-20
"""

import os
from pathlib import Path

# ============================================================================
# Configuration Validation
# ============================================================================

# Get VEP scripts directory
VEP_SCRIPTS = Path(VEP_DIR) / "snakemake" if 'VEP_DIR' in dir() else Path(workflow.basedir)
VEP_MODELS = Path(VEP_DIR) / "models" if 'VEP_DIR' in dir() else Path(workflow.basedir).parent / "models"

# Python interpreter
PYTHON = config.get("PYTHON", "/path/to/anaconda3/envs/snakemake/bin/python")

# Model selection
MODELS_TO_RUN = config.get("MODELS_TO_RUN", ["evo2", "yorzoi", "shorkie", "esm1v"])

# Evo2 configuration
EVO2_MODEL = config.get("EVO2_MODEL", "evo2_7b")
EVO2_CONTAINER = config.get("EVO2_CONTAINER", "/path/to/common/software/evo2_with_dependencies.sif")

# ============================================================================
# Helper Functions
# ============================================================================

def get_fasta_files(fasta_dir, pattern="*_tests_*.fasta"):
    """Get list of FASTA files matching pattern."""
    fasta_dir = Path(fasta_dir)
    return sorted(fasta_dir.glob(pattern))


def get_orfs_from_fasta_dir(fasta_dir, pattern="*_tests_*.fasta"):
    """Extract ORF names from FASTA filenames."""
    fasta_files = get_fasta_files(fasta_dir, pattern)
    orfs = []
    for f in fasta_files:
        # Extract ORF from filename like "YNL085W_tests_50kb.fasta"
        parts = f.stem.split("_tests_")
        if parts:
            orfs.append(parts[0])
    return orfs


# ============================================================================
# VEP Rules
# ============================================================================

# ----------------------------------------------------------------------------
# Rule: Run Evo2 (DNA language model scoring)
# ----------------------------------------------------------------------------
rule run_evo2:
    """
    Run Evo2 7B or 40B model on DNA sequences.

    Evo2 is a DNA language model that scores sequences using perplexity.
    It runs inside a Singularity container for reproducibility.
    """
    input:
        fasta = FASTA_50KB_DIR / "{orf}_tests_50kb.fasta" if 'FASTA_50KB_DIR' in dir() else "fasta_50kb/{orf}_tests_50kb.fasta",
        metadata = METADATA_FILE if 'METADATA_FILE' in dir() else "metadata.tsv"
    output:
        scores = OUTPUT_DIR / "evo2_results/{orf}_scores.tsv" if 'OUTPUT_DIR' in dir() else "evo2_results/{orf}_scores.tsv"
    params:
        script = VEP_SCRIPTS / "02_run_evo2.py",
        model = EVO2_MODEL,
        container = EVO2_CONTAINER,
        output_dir = lambda wildcards, output: Path(output.scores).parent
    resources:
        partition = "gpu",
        gres = "gpu:1" if EVO2_MODEL == "evo2_7b" else "gpu:4",
        constraint = "GPU_SKU:H100_SXM5&GPU_MEM:80GB",
        mem_mb = 64000 if EVO2_MODEL == "evo2_7b" else 256000,
        runtime = 720  # 12 hours in minutes
    shell:
        """
        mkdir -p {params.output_dir}

        singularity exec --nv {params.container} \
            python {params.script} \
            --input {input.fasta} \
            --output {output.scores} \
            --model {params.model} \
            --metadata {input.metadata}
        """


# ----------------------------------------------------------------------------
# Rule: Run Yorzoi (RNA expression prediction)
# ----------------------------------------------------------------------------
rule run_yorzoi:
    """
    Run Yorzoi model for RNA expression prediction.

    Yorzoi is a Borzoi-like model trained on yeast RNA-seq data.
    Uses tiled prediction for sequences longer than 4992 bp.
    """
    input:
        fasta = FASTA_50KB_DIR / "{orf}_tests_50kb.fasta" if 'FASTA_50KB_DIR' in dir() else "fasta_50kb/{orf}_tests_50kb.fasta",
        metadata = METADATA_FILE if 'METADATA_FILE' in dir() else "metadata.tsv"
    output:
        predictions = OUTPUT_DIR / "yorzoi_results/{orf}_predictions.tsv" if 'OUTPUT_DIR' in dir() else "yorzoi_results/{orf}_predictions.tsv"
    params:
        script = VEP_SCRIPTS / "03_run_yorzoi.py",
        conda_env = "yorzoi_local",
        output_dir = lambda wildcards, output: Path(output.predictions).parent
    resources:
        partition = "gpu",
        gres = "gpu:1",
        constraint = "GPU_SKU:A100_SXM4|GPU_SKU:H100_SXM5",  # Requires Ampere+ for flash-attention
        mem_mb = 64000,
        runtime = 720  # 12 hours
    shell:
        """
        mkdir -p {params.output_dir}

        # Proper conda initialization for batch jobs
        eval "$(/path/to/anaconda3/bin/conda shell.bash hook)"
        conda activate {params.conda_env}

        python {params.script} \
            --input {input.fasta} \
            --output {output.predictions} \
            --metadata {input.metadata}
        """


# ----------------------------------------------------------------------------
# Rule: Run Shorkie (8-fold ensemble RNA prediction)
# ----------------------------------------------------------------------------
rule run_shorkie:
    """
    Run Shorkie 8-fold ensemble model.

    Shorkie uses 16kb input sequences and predicts RNA expression
    using an 8-fold cross-validation ensemble.
    """
    input:
        fasta = FASTA_16KB_DIR / "{orf}_tests_16kb.fasta" if 'FASTA_16KB_DIR' in dir() else "fasta_16kb/{orf}_tests_16kb.fasta",
        metadata = METADATA_FILE if 'METADATA_FILE' in dir() else "metadata.tsv"
    output:
        predictions = OUTPUT_DIR / "shorkie_results/{orf}_predictions.tsv" if 'OUTPUT_DIR' in dir() else "shorkie_results/{orf}_predictions.tsv"
    params:
        script = VEP_SCRIPTS / "04_run_shorkie.py",
        conda_env = "shorkie",
        output_dir = lambda wildcards, output: Path(output.predictions).parent
    resources:
        partition = "gpu",
        gres = "gpu:1",
        mem_mb = 64000,
        runtime = 720  # 12 hours
    shell:
        """
        mkdir -p {params.output_dir}

        # Proper conda initialization for batch jobs
        eval "$(/path/to/anaconda3/bin/conda shell.bash hook)"
        conda activate {params.conda_env}

        python {params.script} \
            --input {input.fasta} \
            --output {output.predictions} \
            --metadata {input.metadata}
        """


# ----------------------------------------------------------------------------
# Rule: Run ESM1-v (protein variant scoring)
# ----------------------------------------------------------------------------
rule run_esm1v:
    """
    Run ESM1-v model for protein variant effect prediction.

    ESM1-v scores missense variants using masked language modeling
    to compute delta log-likelihood (mutant - WT).
    """
    input:
        variants = PROTEIN_VARIANTS_FILE if 'PROTEIN_VARIANTS_FILE' in dir() else "protein_variants.tsv",
        metadata = METADATA_FILE if 'METADATA_FILE' in dir() else "metadata.tsv"
    output:
        scores = OUTPUT_DIR / "esm1v_results/all_scores.tsv" if 'OUTPUT_DIR' in dir() else "esm1v_results/all_scores.tsv"
    params:
        script = VEP_SCRIPTS / "05_run_esm1v.py",
        conda_env = "esm1v",
        output_dir = lambda wildcards, output: Path(output.scores).parent
    resources:
        partition = "gpu",
        gres = "gpu:1",
        mem_mb = 32000,
        runtime = 120  # 2 hours (protein variants are faster)
    shell:
        """
        mkdir -p {params.output_dir}

        # Proper conda initialization for batch jobs
        eval "$(/path/to/anaconda3/bin/conda shell.bash hook)"
        conda activate {params.conda_env}

        python {params.script} \
            --input {input.variants} \
            --output {output.scores} \
            --metadata {input.metadata}
        """


# ----------------------------------------------------------------------------
# Rule: Merge all VEP results
# ----------------------------------------------------------------------------
rule merge_vep_results:
    """
    Merge predictions from all VEP models into a single file.

    Joins results on test_id to create a comprehensive prediction table.
    """
    input:
        evo2 = OUTPUT_DIR / "evo2_results/all_scores.tsv" if 'OUTPUT_DIR' in dir() else "evo2_results/all_scores.tsv",
        yorzoi = OUTPUT_DIR / "yorzoi_results/all_predictions.tsv" if 'OUTPUT_DIR' in dir() else "yorzoi_results/all_predictions.tsv",
        shorkie = OUTPUT_DIR / "shorkie_results/all_predictions.tsv" if 'OUTPUT_DIR' in dir() else "shorkie_results/all_predictions.tsv",
        esm1v = OUTPUT_DIR / "esm1v_results/all_scores.tsv" if 'OUTPUT_DIR' in dir() else "esm1v_results/all_scores.tsv"
    output:
        merged = OUTPUT_DIR / "vep_merged_predictions.tsv" if 'OUTPUT_DIR' in dir() else "vep_merged_predictions.tsv"
    params:
        script = VEP_SCRIPTS / "06_merge_results.py"
    resources:
        mem_mb = 16000,
        runtime = 30
    shell:
        """
        {PYTHON} {params.script} \
            --evo2 {input.evo2} \
            --yorzoi {input.yorzoi} \
            --shorkie {input.shorkie} \
            --esm1v {input.esm1v} \
            --output {output.merged}
        """


# ----------------------------------------------------------------------------
# Rule: Aggregate per-ORF results
# ----------------------------------------------------------------------------
rule aggregate_evo2:
    """Aggregate per-ORF Evo2 scores into single file."""
    input:
        lambda wildcards: expand(
            OUTPUT_DIR / "evo2_results/{orf}_scores.tsv" if 'OUTPUT_DIR' in dir() else "evo2_results/{orf}_scores.tsv",
            orf=get_orfs_from_fasta_dir(FASTA_50KB_DIR if 'FASTA_50KB_DIR' in dir() else "fasta_50kb", "*_tests_50kb.fasta")
        )
    output:
        OUTPUT_DIR / "evo2_results/all_scores.tsv" if 'OUTPUT_DIR' in dir() else "evo2_results/all_scores.tsv"
    run:
        import pandas as pd
        dfs = [pd.read_csv(f, sep='\t') for f in input]
        combined = pd.concat(dfs, ignore_index=True)
        combined.to_csv(output[0], sep='\t', index=False)


rule aggregate_yorzoi:
    """Aggregate per-ORF Yorzoi predictions into single file."""
    input:
        lambda wildcards: expand(
            OUTPUT_DIR / "yorzoi_results/{orf}_predictions.tsv" if 'OUTPUT_DIR' in dir() else "yorzoi_results/{orf}_predictions.tsv",
            orf=get_orfs_from_fasta_dir(FASTA_50KB_DIR if 'FASTA_50KB_DIR' in dir() else "fasta_50kb", "*_tests_50kb.fasta")
        )
    output:
        OUTPUT_DIR / "yorzoi_results/all_predictions.tsv" if 'OUTPUT_DIR' in dir() else "yorzoi_results/all_predictions.tsv"
    run:
        import pandas as pd
        dfs = [pd.read_csv(f, sep='\t') for f in input]
        combined = pd.concat(dfs, ignore_index=True)
        combined.to_csv(output[0], sep='\t', index=False)


rule aggregate_shorkie:
    """Aggregate per-ORF Shorkie predictions into single file."""
    input:
        lambda wildcards: expand(
            OUTPUT_DIR / "shorkie_results/{orf}_predictions.tsv" if 'OUTPUT_DIR' in dir() else "shorkie_results/{orf}_predictions.tsv",
            orf=get_orfs_from_fasta_dir(FASTA_16KB_DIR if 'FASTA_16KB_DIR' in dir() else "fasta_16kb", "*_tests_16kb.fasta")
        )
    output:
        OUTPUT_DIR / "shorkie_results/all_predictions.tsv" if 'OUTPUT_DIR' in dir() else "shorkie_results/all_predictions.tsv"
    run:
        import pandas as pd
        dfs = [pd.read_csv(f, sep='\t') for f in input]
        combined = pd.concat(dfs, ignore_index=True)
        combined.to_csv(output[0], sep='\t', index=False)
