"""
Snakemake Rules: BC1-Donor-BC0 Pipeline
=======================================

Reusable rules for processing MAGESTIC bc1-donor-bc0 amplicon data.

Pipeline Steps:
    01:  Parse raw paired FASTQ (read length + orientation auto-detected;
         handles 2x150, 2x300, and asymmetric runs in one code path)
    02:  Combine and collapse across samples
    03:  Link guide-donor-bc0 data (adds guide info from sequencing)
    04:  Map to designed oligos
    05:  Assign BC1 to sub-libraries

To use in a project Snakefile:
    1. Define required variables (see REQUIRED VARIABLES below)
    2. Include this file: include: "/path/to/common/scripts/bc1_donor_bc0_pipeline/snakemake/Snakefile.rules"

REQUIRED VARIABLES (must be defined before include):
    - COMMON_SCRIPTS_DIR: Path to common/scripts/bc1_donor_bc0_pipeline/snakemake/
    - PYTHON: Path to Python interpreter
    - KEYFILE_DIR: Project keyfiles directory
    - FASTQ_DIR: Directory of raw {prefix}_R1.fastq.gz / {prefix}_R2.fastq.gz inputs
    - PARSED_DIR: Output directory for parsed data
    - COMBINED_DIR: Output directory for combined data
    - DATA_TABLES_DIR: Output directory for final tables
    - LOGS_DIR: Output directory for logs

REQUIRED CONFIG KEYS:
    config["sequence_parsing"]: Parsing parameters
    config["collapsing"]: Collapsing parameters
    config["oligo_mapping"]: Oligo mapping parameters
    config["oligo_pools"]: List of oligo pool filenames
    config["resources"]: Resource specifications for each step
    config["guide_donor_bc0_dir"]: Path to guide-donor-bc0 purity filtered data (or null to skip)

Author: Kevin R. Roy
"""

# =============================================================================
# Step 01: Parse raw paired FASTQ (read length auto-detected)
# =============================================================================
# The unified parser 01_parse_bc1_donor_bc0.py supersedes the former split
# 01a_parse_2x150_paired_fastq.py / 01b_parse_2x300_collapsed_fastq.py scripts
# (consolidated ~2026-03; the old split scripts no longer exist anywhere). It
# takes raw R1/R2 and AUTO-DETECTS read lengths, primer orientation, and the
# bc1 prefix from the first ~1000 reads, handling 2x150, 2x300, and asymmetric
# (e.g. R1=228/R2=90) runs in one code path. No upstream merge/collapse step is
# required for parsing — it extracts directly from raw R1/R2 and writes the
# canonical 6-column table (counts, bc1, donor, bc0, SPS, donor_bc0_fragment).
#
# TODO (Phase 3, core/parser.py port): per the auto-detection-with-cross-check
# convention, have the parser compare each auto-detected value (read length,
# orientation, bc1 prefix) against the expected values in
# config["sequence_parsing"] and WARN/flag on mismatch rather than proceeding
# silently. Auto-detection stays primary; the config supplies the expectation.
rule parse_01_bc1_donor_bc0:
    """Parse bc1, donor, bc0 from raw paired FASTQ (read length auto-detected)"""
    input:
        r1 = FASTQ_DIR / "{prefix}_R1.fastq.gz",
        r2 = FASTQ_DIR / "{prefix}_R2.fastq.gz"
    output:
        parsed = PARSED_DIR / "{prefix}_parsed.tsv"
    params:
        script = COMMON_SCRIPTS_DIR / "01_parse_bc1_donor_bc0.py"
    log:
        LOGS_DIR / "01_parse_{prefix}.log"
    shell:
        """
        {PYTHON} {params.script} \\
            {input.r1} \\
            {input.r2} \\
            {output.parsed} \\
            2>&1 | tee {log}
        """


# =============================================================================
# Step 02: Combine and Collapse
# =============================================================================
rule combine_02_collapse:
    """Combine parsed data across samples and collapse similar sequences"""
    input:
        parsed_files = lambda wildcards: expand(
            PARSED_DIR / "{prefix}_parsed.tsv",
            prefix=get_sample_prefixes(wildcards.run_date)
        ),
        sample_key = KEYFILE_DIR / "{run_date}" / config["keyfiles"]["sample_key"],
        plate_key = KEYFILE_DIR / "{run_date}" / config["keyfiles"]["plate_key"]
    output:
        collapsed = COMBINED_DIR / "{run_date}_bc1_donor_bc0_collapsed.tsv",
        purity = COMBINED_DIR / "{run_date}_bc1_purity.tsv"
    params:
        script = COMMON_SCRIPTS_DIR / "02_combine_and_collapse.py",
        parsed_dir = PARSED_DIR,
        donor_edit_distance = config["collapsing"]["donor_edit_distance"],
        bc1_edit_distance = config["collapsing"]["bc1_edit_distance"],
        min_pcr_replicates = config["collapsing"]["min_pcr_replicates"]
    log:
        LOGS_DIR / "02_combine_{run_date}.log"
    threads: config["resources"]["step_02_combine"]["cpus"]
    resources:
        mem_mb = config["resources"]["step_02_combine"]["mem_mb"],
        time = config["resources"]["step_02_combine"]["time"]
    shell:
        """
        {PYTHON} {params.script} \\
            --parsed-dir {params.parsed_dir} \\
            --sample-key {input.sample_key} \\
            --plate-key {input.plate_key} \\
            --run-date {wildcards.run_date} \\
            --output-collapsed {output.collapsed} \\
            --output-purity {output.purity} \\
            --donor-edit-distance {params.donor_edit_distance} \\
            --bc1-edit-distance {params.bc1_edit_distance} \\
            --min-pcr-replicates {params.min_pcr_replicates} \\
            --n-jobs {threads} \\
            2>&1 | tee {log}
        """


# =============================================================================
# Step 03: Link Guide-Donor-BC0 Data
# =============================================================================
rule link_03_guide_donor_bc0:
    """Link BC1s to guide sequences from guide-donor-bc0 sequencing data"""
    input:
        collapsed = COMBINED_DIR / "{run_date}_bc1_donor_bc0_collapsed.tsv"
    output:
        linked = DATA_TABLES_DIR / "{run_date}_bc1_with_guide.tsv"
    params:
        script = COMMON_SCRIPTS_DIR / "03_link_guide_donor_bc0.py",
        guide_donor_bc0_dir = config.get("guide_donor_bc0_dir", None)
    log:
        LOGS_DIR / "03_link_{run_date}.log"
    threads: config["resources"].get("step_03_link", {}).get("cpus", 1)
    resources:
        mem_mb = config["resources"].get("step_03_link", {}).get("mem_mb", 16000),
        time = config["resources"].get("step_03_link", {}).get("time", "01:00:00")
    run:
        if params.guide_donor_bc0_dir:
            shell("""
                {PYTHON} {params.script} \\
                    --input {input.collapsed} \\
                    --guide-donor-bc0-dir {params.guide_donor_bc0_dir} \\
                    --output {output.linked} \\
                    2>&1 | tee {log}
            """)
        else:
            # If no guide data, just copy the collapsed file with renamed columns
            shell("""
                cp {input.collapsed} {output.linked}
                echo "No guide_donor_bc0_dir configured, skipping guide linking" | tee {log}
            """)


# =============================================================================
# Step 04: Map to Designed Oligos
# =============================================================================
rule map_04_oligos:
    """Map donors to designed oligo pool"""
    input:
        bc1_data = expand(DATA_TABLES_DIR / "{run_date}_bc1_with_guide.tsv",
                         run_date=ACTIVE_RUNS),
        oligo_pools = expand(KEYFILE_DIR / "{pool}", pool=config["oligo_pools"])
    output:
        mapped = DATA_TABLES_DIR / "bc1_donor_bc0_mapped_to_oligos.tsv"
    params:
        script = COMMON_SCRIPTS_DIR / "04_map_to_oligos.py",
        guide_start = config["oligo_mapping"]["guide_start"],
        guide_end = config["oligo_mapping"]["guide_end"],
        donor_start = config["oligo_mapping"]["donor_start"],
        donor_end = config["oligo_mapping"]["donor_end"],
        # Optional harmonized-lookup restriction (speed): pass --v-libraries /
        # --nuclease ONLY when the per-screen config provides them. When both keys
        # are absent/empty this renders to "" so the command is byte-identical to
        # the unrestricted default (04_map_to_oligos.py treats absent flags as None
        # = no filter). Accepts list or scalar values in config.
        restrict_args = lambda wildcards: (
            (lambda om: " ".join(
                ([] if not om.get("v_libraries") else
                 ["--v-libraries"] + ([str(om["v_libraries"])] if isinstance(om["v_libraries"], str)
                                      else [str(x) for x in om["v_libraries"]]))
                +
                ([] if not om.get("nuclease") else
                 ["--nuclease"] + ([str(om["nuclease"])] if isinstance(om["nuclease"], str)
                                   else [str(x) for x in om["nuclease"]]))
            ))(config.get("oligo_mapping", {}))
        )
        # NOTE: dropped the dangling --lbcas12a-donor-start flag (2026-06-02) — no
        # version of 04_map_to_oligos.py accepts it (would SystemExit the rule). The
        # fixed-offset idea was never implemented; LbCas12a is handled by the
        # content-based anchor-find (TTTCGAAGAGC) in 04_map_to_oligos / core.matching.
    log:
        LOGS_DIR / "04_map.log"
    threads: config["resources"]["step_04_map"]["cpus"]
    resources:
        mem_mb = config["resources"]["step_04_map"]["mem_mb"],
        time = config["resources"]["step_04_map"]["time"]
    shell:
        """
        {PYTHON} {params.script} \\
            --input {input.bc1_data} \\
            --oligo-pools {input.oligo_pools} \\
            --output {output.mapped} \\
            --guide-start {params.guide_start} \\
            --guide-end {params.guide_end} \\
            --donor-start {params.donor_start} \\
            --donor-end {params.donor_end} {params.restrict_args} \\
            2>&1 | tee {log}
        """


# =============================================================================
# Step 05: Assign BC1 to Sub-libraries
# =============================================================================
rule assign_05_sublibrary:
    """Assign bc1 to sub-libraries based on SPS"""
    input:
        mapped = DATA_TABLES_DIR / "bc1_donor_bc0_mapped_to_oligos.tsv",
        sps_mapping = KEYFILE_DIR / "sps_library_mapping.tsv"
    output:
        reference = DATA_TABLES_DIR / "bc1_reference_table.tsv",
        purity_summary = DATA_TABLES_DIR / "bc1_purity_summary.tsv"
    params:
        script = COMMON_SCRIPTS_DIR / "05_assign_sublibrary.py"
    log:
        LOGS_DIR / "05_assign.log"
    threads: config["resources"]["step_05_assign"]["cpus"]
    resources:
        mem_mb = config["resources"]["step_05_assign"]["mem_mb"],
        time = config["resources"]["step_05_assign"]["time"]
    shell:
        """
        {PYTHON} {params.script} \\
            --input {input.mapped} \\
            --sps-mapping {input.sps_mapping} \\
            --output-reference {output.reference} \\
            --output-summary {output.purity_summary} \\
            2>&1 | tee {log}
        """
