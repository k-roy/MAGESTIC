"""
Snakemake Rules: BC1-From-Screen Pipeline
==========================================

Reusable rules for processing BC1 barcode counts from CRISPR screens with
library-specific tiered analysis.

Pipeline Steps:
    01: Validate collapsed FASTQ files
    02: Parse BC1 from collapsed FASTQ
    03: Sample QC
    04: Combine counts
    05: Error detection
    06: Absorb error counts
    07: Tier classification (per library)
    08: Create DESeq2 count matrix
    09: Combine technical replicates
    10: Split by comparison
    11: DESeq2 single comparison
    12: Slope fitness (timecourse)
    13: Annotate results
    14: Hit calling
    15: Aggregate hits
    16: Rarefaction analysis
    17: DESeq2 rarefaction
    18: Validate sublibrary composition

To use in a project Snakefile:
    1. Define required variables (see REQUIRED VARIABLES below)
    2. Include this file: include: "/path/to/common/scripts/bc1_from_screen_pipeline/snakemake/Snakefile.rules"

REQUIRED VARIABLES (must be defined before include):
    - COMMON_SCRIPTS_DIR: Path to common/scripts/bc1_from_screen_pipeline/snakemake/
    - PYTHON: Path to Python interpreter (with bc1_from_screen env activated)
    - COLLAPSED_FASTQ_DIR: Input directory with collapsed FASTQ files
    - BC1_COUNTS_DIR: Output directory for BC1 counts
    - DESEQ2_DIR: Output directory for DESeq2 results
    - HIT_CALLING_DIR: Output directory for hit calling results
    - KEYFILE_DIR: Project keyfiles directory
    - LOGS_DIR: Output directory for logs
    - LIBRARIES: List of library names (e.g., ["yL437", "yL442"])

REQUIRED CONFIG KEYS:
    config["tier_thresholds"]: Tier classification parameters
    config["deseq2"]: DESeq2 parameters
    config["hit_calling"]: Hit calling parameters
    config["resources"]: Resource specifications for each step
    config["comparisons"]: Step 10 transformation scope ("pooled" or "split"; no default)

Author: Kevin R. Roy
"""

from pathlib import Path

# =============================================================================
# Step 02: Parse BC1 from Collapsed FASTQ
# =============================================================================
rule parse_02_bc1:
    """Extract BC1 barcodes from collapsed FASTQ files"""
    input:
        collapsed_fastq = COLLAPSED_FASTQ_DIR / "{sample}_collapsed.fastq.gz"
    output:
        bc1_counts = BC1_COUNTS_DIR / "parsed" / "{sample}_bc1_counts.tsv"
    params:
        script = COMMON_SCRIPTS_DIR / "02_parse_bc1_reads.py",
        bc1_length = config.get("sequence_parsing", {}).get("bc1_length", 20),
        bc1_prefix = config.get("sequence_parsing", {}).get("bc1_prefix", "CATGCTC"),
        bc1_suffix = config.get("sequence_parsing", {}).get("bc1_suffix", "CCCTAGG"),
        min_counts = config.get("sequence_parsing", {}).get("min_counts", 1)
    log:
        LOGS_DIR / "02_parse_{sample}.log"
    threads: config.get("resources", {}).get("step_02", {}).get("cpus", 4)
    resources:
        mem_mb = config.get("resources", {}).get("step_02", {}).get("mem_mb", 16000),
        time = config.get("resources", {}).get("step_02", {}).get("time", "2:00:00")
    shell:
        """
        {PYTHON} {params.script} \\
            --input {input.collapsed_fastq} \\
            --output {output.bc1_counts} \\
            --bc1-length {params.bc1_length} \\
            --bc1-prefix {params.bc1_prefix} \\
            --bc1-suffix {params.bc1_suffix} \\
            --min-counts {params.min_counts} \\
            2>&1 | tee {log}
        """


# =============================================================================
# Step 03: Sample QC
# =============================================================================
rule qc_03_sample:
    """Sample QC metrics, flags and plots from the combined long-format BC1 counts"""
    input:
        bc1_counts = BC1_COUNTS_DIR / "{screen}_bc1_counts_long_format.tsv",
        sample_key = KEYFILE_DIR / "sample_key.tsv"
    output:
        qc_summary = BC1_COUNTS_DIR / "qc" / "{screen}" / "sample_qc_summary.tsv",
        flagged = BC1_COUNTS_DIR / "qc" / "{screen}" / "flagged_samples.tsv",
        pca = BC1_COUNTS_DIR / "qc" / "{screen}" / "pca_coordinates.tsv",
        plots = directory(BC1_COUNTS_DIR / "qc" / "{screen}" / "plots")
    params:
        script = COMMON_SCRIPTS_DIR / "03_sample_qc.py",
        output_dir = lambda w: str(BC1_COUNTS_DIR / "qc" / w.screen)
    log:
        LOGS_DIR / "03_qc_{screen}.log"
    threads: 1
    shell:
        """
        {PYTHON} {params.script} \\
            --input-long-table {input.bc1_counts} \\
            --keyfile {input.sample_key} \\
            --output-dir {params.output_dir} \\
            --plots-dir {output.plots} \\
            2>&1 | tee {log}
        """


# =============================================================================
# Step 07: Tier Classification
# =============================================================================
rule tier_07_classification:
    """Classify BC1s into tiers based on t0 counts (per library)"""
    input:
        bc1_counts = BC1_COUNTS_DIR / "{screen}_bc1_counts_long_format.tsv",
        ref_table = KEYFILE_DIR / "bc1_reference_table.tsv",
        # FIX 2026-08-06: 07_tier_classification.py REQUIRES --sample-key (it
        # derives t0 from condition + generations == 0); the rule never declared
        # or passed it, so the step aborted with exit 2 before doing any work.
        sample_key = KEYFILE_DIR / "sample_key.tsv"
    output:
        tier_mapping = BC1_COUNTS_DIR / "{screen}_bc1_tier_mapping_{library}.tsv",
        tier_stats = BC1_COUNTS_DIR / "{screen}_tier_stats_{library}.tsv"
    params:
        script = COMMON_SCRIPTS_DIR / "07_tier_classification.py",
        tier_1_min = config.get("tier_thresholds", {}).get("tier_1_min_reads", 100),
        tier_2_min = config.get("tier_thresholds", {}).get("tier_2_min_reads", 20),
        t0_condition = config.get("tier_thresholds", {}).get("t0_condition", "YPD"),
        # MEMORY FIX 2026-08-06: rows per read_csv chunk when streaming the
        # long-format counts file. Memory only -- the tier mapping is byte-
        # identical for any chunksize (proven for 7 / 50k / 2M / 10M).
        chunksize = config.get("resources", {}).get("step_07", {}).get("chunksize", 2000000)
    log:
        LOGS_DIR / "07_tier_{screen}_{library}.log"
    threads: config.get("resources", {}).get("step_07", {}).get("cpus", 4)
    resources:
        # The streaming t0 accumulation (2026-08-06) drops peak RSS from
        # 9.08 GiB to 0.434 GiB on yL406 (122.6M rows); 4 GB is now ample.
        # Override in config if a screen has a far larger t0 BC1 universe.
        mem_mb = config.get("resources", {}).get("step_07", {}).get("mem_mb", 4000)
    shell:
        # FIX 2026-08-06: the flag was `--ref-table`, which the script has never
        # defined -- it is `--bc1-reference` (07_tier_classification.py:54-57).
        # Same defect class as D1 on step 08; both were `error: unrecognized
        # arguments` / missing-required, exit 2.
        """
        {PYTHON} {params.script} \\
            --bc1-counts {input.bc1_counts} \\
            --bc1-reference {input.ref_table} \\
            --sample-key {input.sample_key} \\
            --library {wildcards.library} \\
            --output-tier-mapping {output.tier_mapping} \\
            --output-stats {output.tier_stats} \\
            --tier-1-min {params.tier_1_min} \\
            --tier-2-min {params.tier_2_min} \\
            --t0-condition {params.t0_condition} \\
            --chunksize {params.chunksize} \\
            2>&1 | tee {log}
        """


# =============================================================================
# Step 08: Create DESeq2 Count Matrix
# =============================================================================
rule matrix_08_create:
    """Create wide-format count matrix with consolidated t0 (per library)"""
    input:
        bc1_counts = BC1_COUNTS_DIR / "{screen}_bc1_counts_long_format.tsv",
        tier_mapping = BC1_COUNTS_DIR / "{screen}_bc1_tier_mapping_{library}.tsv",
        sample_key = KEYFILE_DIR / "sample_key.tsv"
    output:
        count_matrix = BC1_COUNTS_DIR / "{screen}_bc1_counts_wide_{library}_combined_tiers.tsv"
    params:
        script = COMMON_SCRIPTS_DIR / "08_create_count_matrix.py",
        # FIX 2026-08-06 (defect D1): this rule passed `--consolidate-t0` /
        # `--t0-groups`, which are the CLI of the ARCHIVED predecessor
        # snakemake/archive/step_d_create_count_matrix.py:72-79. 08 has never
        # accepted them, so the rule died with `error: unrecognized arguments`
        # (exit 2). The script's CLI is canonical -- run_full_pipeline.sh:176-188
        # already drives it with the flags below.
        # Legacy config keys are still honoured: consolidate_t0 == False maps to
        # mode "none", and t0_consolidation_groups is the fallback pseudo-rep count.
        t0_mode = (
            config.get("deseq2", {}).get("t0_consolidation_mode")
            or ("screen_date" if config.get("deseq2", {}).get("consolidate_t0", True) else "none")
        ),
        t0_pseudo_reps = (
            config.get("deseq2", {}).get("t0_pseudo_rep_count")
            or config.get("deseq2", {}).get("t0_consolidation_groups", 4)
        ),
        # NOTE: must be a lambda, not a Path literal -- Snakemake does not expand
        # {wildcards} inside a Path object in `params` (verified by dry-run: the
        # literal "{screen}"/"{library}" reached the shell command unexpanded).
        metadata_output = lambda w: str(
            BC1_COUNTS_DIR / f"{w.screen}_t0_consolidation_metadata_{w.library}.tsv"),
        chunksize = config.get("resources", {}).get("step_08", {}).get("chunksize", 5000000)
    log:
        LOGS_DIR / "08_matrix_{screen}_{library}.log"
    threads: config.get("resources", {}).get("step_08", {}).get("cpus", 4)
    resources:
        # The streaming pivot (2026-08-06) drops peak RSS from 13.6 GiB to
        # 1.5 GiB on yL406; 16 GB is now ample. Override in config if a screen
        # with a much larger keep-set needs more.
        mem_mb = config.get("resources", {}).get("step_08", {}).get("mem_mb", 16000)
    shell:
        """
        {PYTHON} {params.script} \\
            --bc1-counts {input.bc1_counts} \\
            --tier-mapping {input.tier_mapping} \\
            --sample-key {input.sample_key} \\
            --library {wildcards.library} \\
            --output {output.count_matrix} \\
            --metadata-output {params.metadata_output} \\
            --t0-consolidation-mode {params.t0_mode} \\
            --t0-pseudo-rep-count {params.t0_pseudo_reps} \\
            --chunksize {params.chunksize} \\
            2>&1 | tee {log}
        """


# =============================================================================
# Step 10: Split Count Tables by Comparison
# =============================================================================
# The transformation scope has no default (step 10 refuses without one). Set
# config["comparisons"]["transformation_scope"] to "pooled", or to "split" together with
# "bc1_reference_table" and a construction-derived "transformation_column" (e.g. trafo_ID).
# "pooled_dates": true passes --no-consolidate for keys without a screen_date column;
# "exclude_samples_file" lists count columns to drop. A missing key fails the rule loudly.
rule split_10_comparisons:
    """Split count matrix into per-comparison tables within one declared transformation scope"""
    input:
        count_matrix = BC1_COUNTS_DIR / "{screen}_bc1_counts_wide_{library}_combined_tiers.tsv",
        sample_key = KEYFILE_DIR / "sample_key.tsv",
        bc1_reference = lambda w: config["comparisons"].get("bc1_reference_table", [])
    output:
        manifest = BC1_COUNTS_DIR / "counts_for_deseq" / "{library}" / "comparison_manifest.tsv",
        reference_dir = directory(BC1_COUNTS_DIR / "counts_for_deseq" / "{library}" / "reference"),
        treatment_dir = directory(BC1_COUNTS_DIR / "counts_for_deseq" / "{library}" / "treatment")
    params:
        script = COMMON_SCRIPTS_DIR / "10_split_comparisons.py",
        output_dir = lambda w: str(BC1_COUNTS_DIR / "counts_for_deseq" / w.library),
        scope_args = lambda w: {
            "pooled": lambda: "--pool-transformations",
            "split": lambda: "--split-by-yeast-sublibrary --bc1-reference-table {} --yeast-sublibrary-column {}".format(
                config["comparisons"]["bc1_reference_table"], config["comparisons"]["transformation_column"]),
        }[config["comparisons"]["transformation_scope"]](),
        date_args = lambda w: "--no-consolidate" if config["comparisons"].get("pooled_dates", False) else "",
        exclude_args = lambda w: ("--exclude-samples-file {}".format(config["comparisons"]["exclude_samples_file"])
                                  if config["comparisons"].get("exclude_samples_file") else "")
    log:
        LOGS_DIR / "10_split_{library}.log"
    threads: 1
    shell:
        """
        {PYTHON} {params.script} \\
            --count-matrix {input.count_matrix} \\
            --sample-key {input.sample_key} \\
            --library {wildcards.library} \\
            --output-dir {params.output_dir} \\
            {params.scope_args} {params.date_args} {params.exclude_args} \\
            2>&1 | tee {log}
        """


# =============================================================================
# Step 11: DESeq2 Single Comparison
# =============================================================================
rule deseq2_11_single:
    """Run DESeq2 for a single comparison"""
    input:
        reference = BC1_COUNTS_DIR / "counts_for_deseq" / "{library}" / "reference" / "{comparison}_reference.tsv",
        treatment = BC1_COUNTS_DIR / "counts_for_deseq" / "{library}" / "treatment" / "{comparison}_treatment.tsv"
    output:
        results = DESEQ2_DIR / "{library}" / "{comparison}_DESeq2_results.tsv"
    params:
        script = COMMON_SCRIPTS_DIR / "11_deseq2_single.py",
        min_basemean = config.get("deseq2", {}).get("min_basemean", 0)
    log:
        LOGS_DIR / "11_deseq2_{library}_{comparison}.log"
    threads: config.get("resources", {}).get("step_11", {}).get("cpus", 4)
    resources:
        mem_mb = config.get("resources", {}).get("step_11", {}).get("mem_mb", 32000),
        time = config.get("resources", {}).get("step_11", {}).get("time", "2:00:00")
    shell:
        """
        {PYTHON} {params.script} \\
            --reference {input.reference} \\
            --treatment {input.treatment} \\
            --output {output.results} \\
            --comparison {wildcards.comparison} \\
            --library {wildcards.library} \\
            --min-basemean {params.min_basemean} \\
            2>&1 | tee {log}
        """


# =============================================================================
# Step 12: Slope Fitness (Timecourse Analysis)
# =============================================================================
rule slope_12_fitness:
    """Multi-timepoint slope fitness for one condition of one library"""
    input:
        count_matrix = BC1_COUNTS_DIR / "{screen}_bc1_counts_wide_{library}_combined_tiers.tsv",
        sample_key = KEYFILE_DIR / "sample_key.tsv",
        ref_table = KEYFILE_DIR / "bc1_reference_table.tsv"
    output:
        bc1 = DESEQ2_DIR / "{library}" / "slope_fitness" / "{screen}_{condition}_bc1_slope_fitness.tsv",
        variant = DESEQ2_DIR / "{library}" / "slope_fitness" / "{screen}_{condition}_variant_slope_fitness.tsv",
        summary = DESEQ2_DIR / "{library}" / "slope_fitness" / "{screen}_{condition}_slope_fitness_summary.tsv"
    params:
        script = COMMON_SCRIPTS_DIR / "12_slope_fitness.py"
    log:
        LOGS_DIR / "12_slope_{screen}_{library}_{condition}.log"
    threads: 1
    shell:
        """
        {PYTHON} {params.script} \\
            --count-matrix {input.count_matrix} \\
            --sample-key {input.sample_key} \\
            --bc1-reference {input.ref_table} \\
            --output-bc1 {output.bc1} \\
            --output-variant {output.variant} \\
            --output-summary {output.summary} \\
            --library {wildcards.library} \\
            --condition {wildcards.condition:q} \\
            2>&1 | tee {log}
        """


# =============================================================================
# Step 13: Annotate DESeq2 Results
# =============================================================================
rule annotate_13_results:
    """Merge DESeq2 results with variant annotations"""
    input:
        deseq2_results = DESEQ2_DIR / "{library}" / "{comparison}_DESeq2_results.tsv",
        ref_table = KEYFILE_DIR / "bc1_reference_table.tsv",
        tier_mapping = BC1_COUNTS_DIR / "{screen}_bc1_tier_mapping_{library}.tsv",
        oligo_design = KEYFILE_DIR / "oligo_design.tsv"
    output:
        annotated = DESEQ2_DIR / "per_comparison" / "{library}" / "{comparison}_annotated.tsv"
    params:
        script = COMMON_SCRIPTS_DIR / "13_annotate_results.py"
    log:
        LOGS_DIR / "13_annotate_{library}_{comparison}.log"
    threads: 1
    shell:
        """
        {PYTHON} {params.script} \\
            --deseq2-results {input.deseq2_results} \\
            --ref-table {input.ref_table} \\
            --tier-mapping {input.tier_mapping} \\
            --oligo-design {input.oligo_design} \\
            --output {output.annotated} \\
            --library {wildcards.library} \\
            2>&1 | tee {log}
        """


# =============================================================================
# Step 14: Hit Calling Single Comparison
# =============================================================================
rule hit_14_calling:
    """Tier-aware hit calling for a single comparison"""
    input:
        annotated = DESEQ2_DIR / "per_comparison" / "{library}" / "{comparison}_annotated.tsv"
    output:
        hits = HIT_CALLING_DIR / "{library}" / "hits_{comparison}.tsv",
        stats = HIT_CALLING_DIR / "{library}" / "{comparison}_stats.tsv"
    params:
        script = COMMON_SCRIPTS_DIR / "14_hit_calling.py",
        tier_1_z = config.get("hit_calling", {}).get("tier_1_z_threshold", 3.0),
        tier_1_conc = config.get("hit_calling", {}).get("tier_1_concordance", 0.75),
        tier_2_z = config.get("hit_calling", {}).get("tier_2_z_threshold", 3.75),
        tier_2_conc = config.get("hit_calling", {}).get("tier_2_concordance", 0.85),
        use_synonymous_null = config.get("hit_calling", {}).get("use_synonymous_null", True)
    log:
        LOGS_DIR / "14_hit_{library}_{comparison}.log"
    threads: 1
    shell:
        """
        {PYTHON} {params.script} \\
            --input {input.annotated} \\
            --output-hits {output.hits} \\
            --output-stats {output.stats} \\
            --library {wildcards.library} \\
            --comparison {wildcards.comparison} \\
            --tier-1-z {params.tier_1_z} \\
            --tier-1-concordance {params.tier_1_conc} \\
            --tier-2-z {params.tier_2_z} \\
            --tier-2-concordance {params.tier_2_conc} \\
            --use-synonymous-null {params.use_synonymous_null} \\
            2>&1 | tee {log}
        """


# =============================================================================
# Step 15: Aggregate Hit Calls
# =============================================================================
rule aggregate_15_hits:
    """Aggregate variant-level hit tables across comparisons (per library)"""
    input:
        hits = lambda wildcards: expand(
            HIT_CALLING_DIR / "{library}" / "hits_{comparison}.tsv",
            library=wildcards.library,
            comparison=get_comparisons_for_library(wildcards.library)
        )
    output:
        all_hits = HIT_CALLING_DIR / "{library}" / "aggregated" / "{library}_variant_hits_all.tsv",
        significant = HIT_CALLING_DIR / "{library}" / "aggregated" / "{library}_variant_hits_significant.tsv",
        stats = HIT_CALLING_DIR / "{library}" / "aggregated" / "aggregation_stats.json"
    params:
        script = COMMON_SCRIPTS_DIR / "15_aggregate_hits.py",
        input_dir = lambda w: str(HIT_CALLING_DIR / w.library),
        output_dir = lambda w: str(HIT_CALLING_DIR / w.library / "aggregated")
    log:
        LOGS_DIR / "15_aggregate_{library}.log"
    threads: 1
    shell:
        """
        {PYTHON} {params.script} \\
            --input-dir {params.input_dir} \\
            --output-dir {params.output_dir} \\
            --screen-name {wildcards.library} \\
            2>&1 | tee {log}
        """


# =============================================================================
# Step 16: Rarefaction Analysis
# =============================================================================
rule rarefaction_16:
    """Rarefaction of one sample's parsed BC1 counts (sequencing-depth assessment)"""
    input:
        bc1_counts = BC1_COUNTS_DIR / "parsed" / "{sample}_bc1_counts.tsv"
    output:
        rarefaction = BC1_COUNTS_DIR / "qc" / "rarefaction" / "{sample}_rarefaction.tsv",
        summary = BC1_COUNTS_DIR / "qc" / "rarefaction" / "{sample}_rarefaction.summary.tsv"
    params:
        script = COMMON_SCRIPTS_DIR / "16_rarefaction.py",
        data_type = config.get("rarefaction", {}).get("data_type", "bc1_timepoints")
    log:
        LOGS_DIR / "16_rarefaction_{sample}.log"
    threads: 1
    resources:
        mem_mb = config.get("resources", {}).get("step_16", {}).get("mem_mb", 32000)
    shell:
        """
        {PYTHON} {params.script} \\
            --input {input.bc1_counts} \\
            --output {output.rarefaction} \\
            --data-type {params.data_type} \\
            --sample-name {wildcards.sample} \\
            --barcode-column bc1 \\
            --count-column counts \\
            2>&1 | tee {log}
        """
