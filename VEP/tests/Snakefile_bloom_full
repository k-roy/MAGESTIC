"""
Full VEP Pipeline Snakefile for Bloom QTL Data
===============================================

Tests the VEP pipeline with actual 127-gene FDR <= 10% data
from the Bloom et al. QTL study.

Usage:
    # Dry run
    snakemake -s Snakefile_bloom_full -n -p

    # Run with SLURM
    snakemake -s Snakefile_bloom_full --profile slurm

Author: Kevin R. Roy
Date: 2026-02-20
"""

from pathlib import Path

# ============================================================================
# Configuration
# ============================================================================

# Base directories
BASE_DIR = Path("/path/to")
VEP_DIR = BASE_DIR / "common/scripts/variant_effect_prediction"

# Project-specific data
PROJECT_DIR = BASE_DIR / "projects/QTL/20260210_variant_effect_prediction"
DATA_DIR = PROJECT_DIR / "processed_data/20260205_in_silico_QTN_dissection/pairwise_tests_50kb"

# Input paths - actual data
FASTA_50KB_DIR = DATA_DIR / "fasta_50kb"
FASTA_16KB_DIR = DATA_DIR / "fasta_16kb_shorkie"
PROTEIN_VARIANTS_FILE = DATA_DIR / "esm1v_results/protein_variants_by_strain.tsv"
METADATA_DIR = DATA_DIR / "metadata"

# Output directory
OUTPUT_DIR = DATA_DIR / "vep_snakemake_results"

# Python interpreter
PYTHON = "/path/to/anaconda3/envs/snakemake/bin/python"

# VEP scripts
VEP_SCRIPTS = VEP_DIR / "snakemake"

# Evo2 configuration
EVO2_MODEL = "evo2_7b"
EVO2_CONTAINER = Path("/path/to/common/software/evo2_with_dependencies.sif")

# ============================================================================
# Helper Functions
# ============================================================================

def get_orfs_from_fasta_dir(fasta_dir, pattern="*_tests_*.fasta"):
    """Extract ORF names from FASTA filenames."""
    fasta_dir = Path(fasta_dir)
    orfs = []
    for f in sorted(fasta_dir.glob(pattern)):
        parts = f.stem.split("_tests_")
        if parts:
            orfs.append(parts[0])
    return orfs

# Get ORFs from actual data
ORFS_50KB = get_orfs_from_fasta_dir(FASTA_50KB_DIR, "*_tests_50kb.fasta")
ORFS_16KB = get_orfs_from_fasta_dir(FASTA_16KB_DIR, "*_tests_16kb.fasta")

# Validate we have the expected data
assert len(ORFS_50KB) == 127, f"Expected 127 ORFs for 50kb, got {len(ORFS_50KB)}"
assert len(ORFS_16KB) == 127, f"Expected 127 ORFs for 16kb, got {len(ORFS_16KB)}"

print(f"Pipeline configuration:")
print(f"  - 50kb FASTAs: {len(ORFS_50KB)} ORFs")
print(f"  - 16kb FASTAs: {len(ORFS_16KB)} ORFs")
print(f"  - Protein variants: {PROTEIN_VARIANTS_FILE}")
print(f"  - Output: {OUTPUT_DIR}")

# ============================================================================
# Target Rules
# ============================================================================

rule all:
    """Default target: run all VEP models and merge results."""
    input:
        OUTPUT_DIR / "vep_merged_predictions.tsv"


rule evo2_only:
    """Run only Evo2 model."""
    input:
        OUTPUT_DIR / "evo2_results/all_scores.tsv"


rule yorzoi_only:
    """Run only Yorzoi model."""
    input:
        OUTPUT_DIR / "yorzoi_results/all_predictions.tsv"


rule shorkie_only:
    """Run only Shorkie model."""
    input:
        OUTPUT_DIR / "shorkie_results/all_predictions.tsv"


rule esm1v_only:
    """Run only ESM1-v model."""
    input:
        OUTPUT_DIR / "esm1v_results/all_scores.tsv"


# ============================================================================
# Model Rules
# ============================================================================

rule run_evo2:
    """Run Evo2 on a single ORF's sequences."""
    input:
        fasta = FASTA_50KB_DIR / "{orf}_tests_50kb.fasta"
    output:
        scores = OUTPUT_DIR / "evo2_results/{orf}_scores.tsv"
    params:
        script = VEP_SCRIPTS / "02_run_evo2.py",
        model = EVO2_MODEL,
        container = EVO2_CONTAINER
    resources:
        partition = "gpu",
        gres = "gpu:1",
        constraint = "GPU_SKU:H100_SXM5&GPU_MEM:80GB",
        mem_mb = 64000,
        runtime = 720  # 12 hours
    shell:
        """
        {PYTHON} {params.script} \
            --input {input.fasta} \
            --output {output.scores} \
            --model {params.model} \
            --container {params.container}
        """


rule run_yorzoi:
    """Run Yorzoi on a single ORF's sequences."""
    input:
        fasta = FASTA_50KB_DIR / "{orf}_tests_50kb.fasta"
    output:
        predictions = OUTPUT_DIR / "yorzoi_results/{orf}_predictions.tsv"
    params:
        script = VEP_SCRIPTS / "03_run_yorzoi.py",
        conda_env = "yorzoi_local"
    resources:
        partition = "gpu",
        gres = "gpu:1",
        constraint = "GPU_SKU:A100_SXM4|GPU_SKU:H100_SXM5",
        mem_mb = 64000,
        runtime = 720
    shell:
        """
        {PYTHON} {params.script} \
            --input {input.fasta} \
            --output {output.predictions} \
            --conda-env {params.conda_env}
        """


rule run_shorkie:
    """Run Shorkie on a single ORF's sequences."""
    input:
        fasta = FASTA_16KB_DIR / "{orf}_tests_16kb.fasta"
    output:
        predictions = OUTPUT_DIR / "shorkie_results/{orf}_predictions.tsv"
    params:
        script = VEP_SCRIPTS / "04_run_shorkie.py",
        conda_env = "shorkie"
    resources:
        partition = "gpu",
