"""
Test Snakefile for VEP Pipeline
================================

This Snakefile tests the VEP pipeline with mock data for
127 Bloom et al. QTL loci (FDR <= 10%).

Usage:
    # Dry run
    snakemake -n -p

    # Run locally (testing)
    snakemake --cores 4

Author: Kevin R. Roy
Date: 2026-02-20
"""

from pathlib import Path

# ============================================================================
# Configuration
# ============================================================================

# Base directories
VEP_DIR = Path("/path/to/common/scripts/variant_effect_prediction")
TEST_DIR = VEP_DIR / "tests"

# Input paths
FASTA_50KB_DIR = TEST_DIR / "fasta_50kb"
FASTA_16KB_DIR = TEST_DIR / "fasta_16kb"
PROTEIN_VARIANTS_FILE = TEST_DIR / "protein_variants.tsv"
METADATA_FILE = TEST_DIR / "metadata.tsv"

# Output directory
OUTPUT_DIR = TEST_DIR / "output"

# Python interpreter
PYTHON = "/path/to/anaconda3/envs/snakemake/bin/python"

# VEP scripts
VEP_SCRIPTS = VEP_DIR / "snakemake"

# Evo2 configuration
EVO2_MODEL = "evo2_7b"
EVO2_CONTAINER = Path("/path/to/common/software/evo2_with_dependencies.sif")

# Models to run
MODELS_TO_RUN = ["evo2", "yorzoi", "shorkie", "esm1v"]

# ============================================================================
# Helper Functions
# ============================================================================

def get_orfs_from_fasta_dir(fasta_dir, pattern="*_tests_*.fasta"):
    """Extract ORF names from FASTA filenames."""
    fasta_dir = Path(fasta_dir)
    orfs = []
    for f in sorted(fasta_dir.glob(pattern)):
        parts = f.stem.split("_tests_")
        if parts:
            orfs.append(parts[0])
    return orfs

# Get ORFs from test data
ORFS_50KB = get_orfs_from_fasta_dir(FASTA_50KB_DIR, "*_tests_50kb.fasta")
ORFS_16KB = get_orfs_from_fasta_dir(FASTA_16KB_DIR, "*_tests_16kb.fasta")

# ============================================================================
# Target Rules
# ============================================================================

rule all:
    """Default target: run all VEP models and merge results."""
    input:
        OUTPUT_DIR / "vep_merged_predictions.tsv"


rule test_evo2_only:
    """Run only Evo2 model."""
    input:
        OUTPUT_DIR / "evo2_results/all_scores.tsv"


rule test_yorzoi_only:
    """Run only Yorzoi model."""
    input:
        OUTPUT_DIR / "yorzoi_results/all_predictions.tsv"


rule test_shorkie_only:
    """Run only Shorkie model."""
    input:
        OUTPUT_DIR / "shorkie_results/all_predictions.tsv"


rule test_esm1v_only:
    """Run only ESM1-v model."""
    input:
        OUTPUT_DIR / "esm1v_results/all_scores.tsv"


# ============================================================================
# Model Rules
# ============================================================================

rule run_evo2:
    """Run Evo2 on a single ORF's sequences."""
    input:
        fasta = FASTA_50KB_DIR / "{orf}_tests_50kb.fasta",
        metadata = METADATA_FILE
    output:
        scores = OUTPUT_DIR / "evo2_results/{orf}_scores.tsv"
    params:
        script = VEP_SCRIPTS / "02_run_evo2.py",
        model = EVO2_MODEL,
        container = EVO2_CONTAINER
    resources:
        partition = "gpu",
        gres = "gpu:1",
        mem_mb = 64000,
        runtime = 720  # 12 hours
    shell:
        """
        mkdir -p $(dirname {output.scores})

        # For testing, just create a mock output
        echo "Test mode: would run Evo2 on {input.fasta}"

        # Mock output for dry-run testing
        echo -e "test_id\\tscore\\tprediction" > {output.scores}
        grep "^>" {input.fasta} | sed 's/>//' | while read id; do
            echo -e "$id\\t-0.5\\tneutral"
        done >> {output.scores}
        """


rule run_yorzoi:
    """Run Yorzoi on a single ORF's sequences."""
    input:
        fasta = FASTA_50KB_DIR / "{orf}_tests_50kb.fasta",
        metadata = METADATA_FILE
    output:
        predictions = OUTPUT_DIR / "yorzoi_results/{orf}_predictions.tsv"
    params:
        script = VEP_SCRIPTS / "03_run_yorzoi.py",
        conda_env = "yorzoi_local"
    resources:
        partition = "gpu",
        gres = "gpu:1",
        mem_mb = 64000,
        runtime = 720
    shell:
        """
        mkdir -p $(dirname {output.predictions})

        # For testing, just create a mock output
        echo "Test mode: would run Yorzoi on {input.fasta}"

        # Mock output
        echo -e "test_id\\tscore\\tlog2fc" > {output.predictions}
        grep "^>" {input.fasta} | sed 's/>//' | while read id; do
            echo -e "$id\\t1.0\\t0.05"
        done >> {output.predictions}
        """


rule run_shorkie:
    """Run Shorkie on a single ORF's sequences."""
    input:
        fasta = FASTA_16KB_DIR / "{orf}_tests_16kb.fasta",
        metadata = METADATA_FILE
    output:
        predictions = OUTPUT_DIR / "shorkie_results/{orf}_predictions.tsv"
    params:
        script = VEP_SCRIPTS / "04_run_shorkie.py",
        conda_env = "shorkie"
    resources:
        partition = "gpu",
        gres = "gpu:1",
        mem_mb = 64000,
        runtime = 720
    shell:
        """
        mkdir -p $(dirname {output.predictions})

        # For testing, just create a mock output
        echo "Test mode: would run Shorkie on {input.fasta}"

        # Mock output
        echo -e "test_id\\tscore\\tlog2fc" > {output.predictions}
        grep "^>" {input.fasta} | sed 's/>//' | while read id; do
            echo -e "$id\\t1.0\\t-0.02"
        done >> {output.predictions}
        """


rule run_esm1v:
    """Run ESM1-v on protein variants."""
    input:
        variants = PROTEIN_VARIANTS_FILE,
        metadata = METADATA_FILE
    output:
        scores = OUTPUT_DIR / "esm1v_results/all_scores.tsv"
    params:
        script = VEP_SCRIPTS / "05_run_esm1v.py",
        conda_env = "esm1v"
    resources:
        partition = "gpu",
        gres = "gpu:1",
        mem_mb = 32000,
        runtime = 120
    shell:
        """
        mkdir -p $(dirname {output.scores})

        # For testing, just create a mock output
        echo "Test mode: would run ESM1-v on {input.variants}"

        # Mock output from protein variants
        echo -e "test_id\\tscore\\tprediction" > {output.scores}
        tail -n +2 {input.variants} | cut -f6 | while read id; do
            echo -e "$id\\t-5.2\\tneutral"
        done >> {output.scores}
        """


# ============================================================================
# Aggregation Rules
# ============================================================================

rule aggregate_evo2:
    """Aggregate per-ORF Evo2 scores into single file."""
    input:
        expand(OUTPUT_DIR / "evo2_results/{orf}_scores.tsv", orf=ORFS_50KB)
    output:
        OUTPUT_DIR / "evo2_results/all_scores.tsv"
    run:
        import pandas as pd
        dfs = [pd.read_csv(f, sep='\t') for f in input]
        combined = pd.concat(dfs, ignore_index=True)
        combined.to_csv(output[0], sep='\t', index=False)


rule aggregate_yorzoi:
    """Aggregate per-ORF Yorzoi predictions into single file."""
    input:
        expand(OUTPUT_DIR / "yorzoi_results/{orf}_predictions.tsv", orf=ORFS_50KB)
    output:
        OUTPUT_DIR / "yorzoi_results/all_predictions.tsv"
    run:
        import pandas as pd
        dfs = [pd.read_csv(f, sep='\t') for f in input]
        combined = pd.concat(dfs, ignore_index=True)
        combined.to_csv(output[0], sep='\t', index=False)


rule aggregate_shorkie:
    """Aggregate per-ORF Shorkie predictions into single file."""
    input:
        expand(OUTPUT_DIR / "shorkie_results/{orf}_predictions.tsv", orf=ORFS_16KB)
    output:
        OUTPUT_DIR / "shorkie_results/all_predictions.tsv"
    run:
        import pandas as pd
        dfs = [pd.read_csv(f, sep='\t') for f in input]
        combined = pd.concat(dfs, ignore_index=True)
        combined.to_csv(output[0], sep='\t', index=False)


# ============================================================================
# Merge Results
# ============================================================================

rule merge_vep_results:
    """Merge all VEP model predictions."""
    input:
        evo2 = OUTPUT_DIR / "evo2_results/all_scores.tsv",
        yorzoi = OUTPUT_DIR / "yorzoi_results/all_predictions.tsv",
        shorkie = OUTPUT_DIR / "shorkie_results/all_predictions.tsv",
        esm1v = OUTPUT_DIR / "esm1v_results/all_scores.tsv"
    output:
        merged = OUTPUT_DIR / "vep_merged_predictions.tsv"
    params:
        script = VEP_SCRIPTS / "06_merge_results.py"
    shell:
        """
        {PYTHON} {params.script} \
            --evo2 {input.evo2} \
            --yorzoi {input.yorzoi} \
            --shorkie {input.shorkie} \
            --esm1v {input.esm1v} \
            --output {output.merged}
        """
